# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Neon Postgres
# Pooled connection (has -pooler in host) — used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no -pooler) — preferred for prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Supabase Storage (RFP uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for original RFP files (create in Supabase Storage)
SUPABASE_RFP_BUCKET=rfp-uploads

# AI provider. OpenAI (GPT-4.1) is used whenever OPENAI_API_KEY is set.
# LLM_PROVIDER only picks between anthropic and gemini when there is no OpenAI key.
LLM_PROVIDER=openai

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
# GEMINI_DRAFTING_MODEL=gemini-3.5-flash

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_DRAFTING_MODEL=claude-sonnet-4-20250514

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Optional overrides (default gpt-4.1 for both)
# OPENAI_EXTRACTION_MODEL=gpt-4.1
# OPENAI_DRAFTING_MODEL=gpt-4.1

# Optional: Slack-compatible webhook that receives an alert when an account hits its monthly AI spend cap
# ALERT_WEBHOOK_URL=

# Admin panel (/admin): comma-separated, verified Clerk email addresses allowed in
# ADMIN_EMAILS=you@example.com

# --- Error alerts (Sentry) -------------------------------------------------
# Off until the DSN is set. Sentry > Project settings > Client Keys (DSN).
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o0000.ingest.sentry.io/0000
# Optional: readable stack traces. Sentry > Settings > Auth Tokens.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Review request after an export ----------------------------------------
# Off until REVIEW_URL is set (must start with https://), e.g. your Trustpilot
# "write a review" link. SUPPORT_EMAIL enables the "Send private feedback" option.
# REVIEW_URL=https://www.trustpilot.com/evaluate/yourdomain.com
# SUPPORT_EMAIL=support@yourdomain.com

# --- Payments (Dodo Payments, merchant of record) --------------------------
# Off until every value below is set; until then paid plans are requested by email.
# Step-by-step setup: FOUNDER_TODO.md, "Dodo Payments".
# DODO_PAYMENTS_ENVIRONMENT=test_mode          # live_mode once test payments work
# DODO_PAYMENTS_API_KEY=                       # Dodo > Developer > API Keys
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...          # Dodo > Developer > Webhooks > your endpoint
# Product IDs (pdt_...) from Dodo > Products:
# DODO_PRODUCT_SINGLE_BID=
# DODO_PRODUCT_STARTER_MONTHLY=
# DODO_PRODUCT_STARTER_ANNUAL=
# DODO_PRODUCT_PRO_MONTHLY=
# DODO_PRODUCT_PRO_ANNUAL=
# DODO_PRODUCT_EXTRA_PROPOSAL_STARTER=
# DODO_PRODUCT_EXTRA_PROPOSAL_PRO=
