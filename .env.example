# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Neon Postgres
# Pooled connection (has -pooler in host) — used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no -pooler) — preferred for prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Supabase Storage (RFP uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for original RFP files (create in Supabase Storage)
SUPABASE_RFP_BUCKET=rfp-uploads

# LLM provider: gemini (default, cheaper for testing) | anthropic (production Claude)
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
# GEMINI_DRAFTING_MODEL=gemini-3.5-flash

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_DRAFTING_MODEL=claude-sonnet-4-20250514
